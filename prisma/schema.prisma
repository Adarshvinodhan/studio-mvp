generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PackageStatus {
  ACTIVE
  ARCHIVED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  COMPLETED
}

enum PaymentMethod {
  UPI
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

model Customer {
  id         String      @id @default(cuid())
  name       String
  phone      String?
  whatsapp   String?
  email      String?
  address    String?
  notes      String?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  events     Event[]
  quotations Quotation[]

  @@map("customers")
}

model Event {
  id          String      @id @default(cuid())
  customerId  String      @map("customer_id")
  name        String
  type        String?
  eventDate   DateTime?   @map("event_date")
  location    String?
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotations  Quotation[]

  @@index([customerId])
  @@map("events")
}

model Package {
  id          String        @id @default(cuid())
  name        String
  description String?
  coverImage  String?       @map("cover_image")
  status      PackageStatus @default(ACTIVE)
  basePrice   Decimal       @default(0) @map("base_price") @db.Decimal(12, 2)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  items       PackageItem[]

  @@map("packages")
}

model PackageItem {
  id          String  @id @default(cuid())
  packageId   String  @map("package_id")
  name        String
  description String?
  category    String?
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)
  sortOrder   Int     @default(0) @map("sort_order")
  package     Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("package_items")
}

model Quotation {
  id              String           @id @default(cuid())
  quotationNumber String           @unique @map("quotation_number")
  customerId      String           @map("customer_id")
  eventId         String?          @map("event_id")
  packageId       String?          @map("package_id")
  status          QuotationStatus  @default(DRAFT)
  issuedDate      DateTime?        @map("issued_date")
  subtotal        Decimal          @default(0) @db.Decimal(12, 2)
  discount        Decimal          @default(0) @db.Decimal(12, 2)
  tax             Decimal          @default(0) @db.Decimal(12, 2)
  total           Decimal          @default(0) @db.Decimal(12, 2)
  notes           String?
  terms           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  event           Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  items           QuotationItem[]
  payments        Payment[]

  @@index([customerId])
  @@index([eventId])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String    @map("quotation_id")
  name        String
  description String?
  category    String?
  quantity    Decimal   @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal   @default(0) @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal   @default(0) @map("line_total") @db.Decimal(12, 2)
  sortOrder   Int       @default(0) @map("sort_order")
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model Payment {
  id              String        @id @default(cuid())
  quotationId     String        @map("quotation_id")
  amount          Decimal       @db.Decimal(12, 2)
  paymentDate     DateTime      @map("payment_date")
  paymentMethod   PaymentMethod @default(UPI) @map("payment_method")
  referenceNumber String?       @map("reference_number")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  quotation       Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  receipt         Receipt?

  @@index([quotationId])
  @@map("payments")
}

model Receipt {
  id            String   @id @default(cuid())
  paymentId     String   @unique @map("payment_id")
  receiptNumber String   @unique @map("receipt_number")
  generatedAt   DateTime @default(now()) @map("generated_at")
  pdfPath       String?  @map("pdf_path")
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

model PortfolioImage {
  id        String   @id @default(cuid())
  name      String
  filePath  String   @map("file_path")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("portfolio_images")
}

model BusinessSettings {
  id                 String   @id @default(cuid())
  businessName       String   @default("Camtrio Weddings") @map("business_name")
  logo               String?
  address            String?
  phone              String?
  email              String?
  bankHolderName     String?  @map("bank_holder_name")
  bankAccountNumber  String?  @map("bank_account_number")
  ifsc               String?
  upiNumber          String?  @map("upi_number")
  defaultTerms       String?  @map("default_terms")
  quotationPrefix    String   @default("CAM") @map("quotation_prefix")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("business_settings")
}

model Counter {
  id    String @id
  value Int    @default(0)

  @@map("counters")
}
