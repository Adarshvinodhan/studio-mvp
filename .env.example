# Database (Neon / local Postgres / Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Single-admin login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
AUTH_SECRET="replace-with-a-long-random-string"

# Supabase Storage (required on Vercel for uploads + PDFs)
# Project URL: https://YOUR_PROJECT_REF.supabase.co
# Service role key: Project Settings → API → service_role
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Optional bucket name (default: uploads). Created automatically if missing.
# SUPABASE_STORAGE_BUCKET="uploads"

# Optional
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
